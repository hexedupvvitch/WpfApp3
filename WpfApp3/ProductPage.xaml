<Page x:Class="WpfApp3.ProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp3"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProductPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        
        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left" Grid.Row="0" Grid.ColumnSpan="3">


            <StackPanel Margin="10" Orientation="Horizontal">
                <TextBlock Text="поиск по наименованию" FontSize="15" Foreground="#3E2C23" FontFamily="Times New Roman"></TextBlock>
                <TextBox Name="TBoxSearch" TextChanged="TBoxSearch_TextChanged"
                 Width="250" FontSize="15" BorderBrush="#D9CCBC" BorderThickness="2"></TextBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="10">
                <ComboBox Name="ComboSort" SelectionChanged="ComboSort_SelectionChanged" BorderBrush="#D9CCBC" BorderThickness="2"
                  FontSize="15" Width="300" FontFamily="Times New Roman">
                    <TextBlock>сортировка</TextBlock>
                    <TextBlock>от А до Я</TextBlock>
                    <TextBlock>от Я до А</TextBlock>
                </ComboBox>
            </StackPanel>
        </WrapPanel>


        <ListView Name ="ProductListView" Grid.Row="1" Grid.ColumnSpan="3" SelectionChanged="AgentsListView_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#D9CCBC" BorderThickness="1" Margin="5" CornerRadius="0">
                        <Grid ShowGridLines="False" Margin="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="700"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="0" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding product_name}" FontSize="17" FontWeight="SemiBold" Foreground="#3E2C23" Margin="5" FontFamily="Times New Roman"></TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="2" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding composition}" FontSize="13" Foreground="#8A7566" TextWrapping="Wrap" Margin="5" FontFamily="Times New Roman"></TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="1" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding description}" FontSize="13" Foreground="#8A7566" TextWrapping="Wrap" Margin="5" FontFamily="Times New Roman"></TextBlock>
                            </StackPanel>

                            <TextBlock Text="{Binding TotalQuantity, StringFormat=В наличии: {0} шт.}" FontSize="13" HorizontalAlignment="Right" Foreground="#8A7566" TextWrapping="Wrap" Margin="5" FontFamily="Times New Roman" Grid.Column="1" Grid.Row="0"></TextBlock>

                            <TextBlock Text="{Binding price, StringFormat={}{0} ₽ pc}" Grid.Column="1" Grid.Row="3" HorizontalAlignment="Right" FontSize="15" FontWeight="Bold" Foreground="#B07D48" FontFamily="Times New Roman"></TextBlock>
                            
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" >
            <Button Name="LeftDirButton" Content="&lt;" Width="25" Height="35" Click="LeftDirButton_Click" FontFamily="Times New Roman"/>
            <ListBox FontSize="20" Name="PageListBox" MouseUp="PageListBox_MouseUp">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
            <Button Name="RightDirButton" Content="&gt;" Width="25" Height="35" Click="RightDirButton_Click" FontFamily="Times New Roman"/>
        </StackPanel>
    </Grid>
</Page>
