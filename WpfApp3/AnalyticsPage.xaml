<Page x:Class="WpfApp3.AnalyticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp3"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AnalyticsPage">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Аналитика продаж" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <Border Grid.Row="1" Background="#D2F6E7" Padding="10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="С: " FontSize="16" VerticalAlignment="Center"/>
                <DatePicker Name="DpStart" Width="180" Height="30" FontSize="14" Margin="0,0,15,0" SelectedDateChanged="Date_Changed"/>

                <TextBlock Text="По: " FontSize="16" VerticalAlignment="Center"/>
                <DatePicker Name="DpEnd" Width="180" Height="30" FontSize="14" Margin="0,0,15,0" SelectedDateChanged="Date_Changed"/>

                <Button Content="Экспорт в PDF" Width="160" Height="32" FontSize="14" Background="#70B2AF" Foreground="White" BorderThickness="0" Click="BtnExport_Click"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="#F5F5F5" BorderBrush="#CCCCCC" BorderThickness="1" Padding="15" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <StackPanel Margin="30,0">
                    <TextBlock Text="Всего заказов" FontSize="14" Foreground="Gray"/>
                    <TextBlock Name="TbTotalOrders" Text="0" FontSize="32" FontWeight="Bold" Foreground="#70B2AF"/>
                </StackPanel>
                <StackPanel Margin="30,0">
                    <TextBlock Text="Сумма продаж" FontSize="14" Foreground="Gray"/>
                    <TextBlock Name="TbTotalSum" Text="0,00 руб." FontSize="32" FontWeight="Bold" Foreground="#70B2AF"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" BorderBrush="#CCCCCC" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Топ-5 моделей по количеству проданных пар" FontSize="18" FontWeight="Bold" Margin="10"/>

                <ListView Grid.Row="1" Name="ListViewTop5" BorderThickness="0" Margin="10">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="№" Width="50" DisplayMemberBinding="{Binding Rank}"/>
                            <GridViewColumn Header="Модель" Width="400" DisplayMemberBinding="{Binding ProductName}"/>
                            <GridViewColumn Header="Производитель" Width="250" DisplayMemberBinding="{Binding ManufactureName}"/>
                            <GridViewColumn Header="Кол-во пар" Width="150" DisplayMemberBinding="{Binding TotalQuantity}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
