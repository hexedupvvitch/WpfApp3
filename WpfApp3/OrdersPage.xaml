<Page x:Class="WpfApp3.OrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp3"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="OrdersPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Все заказы" FontSize="24" FontWeight="Bold" Margin="10"/>

        <ListView Name="OrdersListView" Grid.Row="1" Margin="10" SelectionChanged="OrdersListView_SelectionChanged" HorizontalContentAlignment="Stretch">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#70B2AF" BorderThickness="1" Margin="5" Padding="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <!-- Заказ № -->
                                <ColumnDefinition Width="200"/>
                                <!-- Дата -->
                                <ColumnDefinition Width="200"/>
                                <!-- ФИО (заберет всё свободное место) -->
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="200"/>
                                <!-- Кнопка -->
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding order_number, StringFormat=Заказ №{0}}" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="1" Text="{Binding order_date, StringFormat=Дата: {0:dd.MM.yyyy}}" FontSize="14" VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="2" Text="{Binding users.last_name}" FontSize="14" VerticalAlignment="Center" Margin="20,0,0,0"/>

                            
                                <Button Grid.Column="3" Content="Удалить" Background="IndianRed" Foreground="White" Click="DeleteOrder_Click" Tag="{Binding}" Height="30" VerticalAlignment="Center" Margin="5,0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.UserRole, RelativeSource={RelativeSource AncestorType=ListView}}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DataContext.UserRole, RelativeSource={RelativeSource AncestorType=ListView}}" Value="3">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

    </Grid>
</Page>
