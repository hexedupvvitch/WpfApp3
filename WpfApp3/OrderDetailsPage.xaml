<Page x:Class="WpfApp3.OrderDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp3"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="OrderDetailsPage">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="10">
            <TextBlock Name="TitleText" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Список товаров в заказе -->
        <ListView Name="OrderItemsListView" Grid.Row="1" Margin="10" HorizontalContentAlignment="Stretch">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="LightGray" BorderThickness="1" Margin="0,5,0,5" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="250"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding stock_items.products.product_name}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding stock_items.Size, StringFormat=Размер: {0}}" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding quantity, StringFormat=Кол-во: {0} шт.}" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="{Binding price, StringFormat={}{0} ₽}" FontSize="16" FontWeight="Bold" Foreground="Green" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                            <!-- Кнопки +/-/Удалить (только для админа) -->
                            <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=Page}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <Button Content="-" Width="30" Height="30" Margin="5,0" Click="Minus_Click" Tag="{Binding}"/>
                                <Button Content="+" Width="30" Height="30" Margin="5,0" Click="Plus_Click" Tag="{Binding}"/>
                                <Button Content="Удалить" Width="80" Height="30" Margin="10,0,0,0" Background="IndianRed" Foreground="White" Click="RemoveItem_Click" Tag="{Binding}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Итоговая сумма -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <TextBlock Text="Итого по заказу: " FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Name="TotalSumText" FontSize="18" FontWeight="Bold" Foreground="Green" VerticalAlignment="Center" Margin="5,0,0,0"/>
        </StackPanel>
    </Grid>
</Page>
